{
  "name": "xuanpablo/filament-dbview",
  "version": "0.2.0",
  "description": "Database viewer plugin: Database viewer with table browser and data explorer",
  "type": "library",
  "license": "MIT",
  "keywords": ["Laravel", "Filament", "Platform"],
  "homepage": "https://github.com/xuanpablo/filament-dbview",
  "authors": [
    { "name": "xuanpablo" }
  ],
  "support": {
    "email": "xp@pasqual.dev",
    "source": "https://github.com/xuanpablo/filament-dbview"
  },
  "require": {
    "php": "^8.3",
    "filament/filament": "^5.0",
    "illuminate/support": "^13.0",
    "spatie/laravel-package-tools": "^1.93"
  },
  "autoload": {
    "psr-4": {
      "Xuanpablo\\Dbview\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Xuanpablo\\Dbview\\Providers\\DatabaseViewerServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
